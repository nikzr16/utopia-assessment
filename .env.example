# Copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).

# --- Browser app (Supabase dashboard -> Settings -> API) --------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_...) or the legacy anon key; both work.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side / script only ----------------------------------------------
# Used ONLY by `npm run auth:create-staff-logins` (Node, never bundled).
# NEVER prefix these with VITE_: anything starting with VITE_ is shipped to the browser.
# The secret key (sb_secret_...) bypasses row level security; keep it private.
SUPABASE_SECRET_KEY=
# Initial password given to every demo staff sign-in account (min 8 characters).
STAFF_DEMO_PASSWORD=
